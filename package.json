{
  "name": "honotreez",
  "description": "honotreez is boilerplate for backend development with Hono, Drizzle ORM, and Better Auth.",
  "scripts": {
    "dev": "bun run --bun --hot src/index.ts",
    "start": "bun run src/index.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "bunx oxlint . --tsconfig ./tsconfig.json --type-aware",
    "lint:fix": "bunx oxlint . --tsconfig ./tsconfig.json --type-aware --fix --fix-suggestions",
    "check": "bun run format && bun run lint",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:seed": "bun --bun ./src/db/seeders/seed.ts",
    "db:reset": "bun --bun ./src/db/seeders/reset.ts",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.7.4",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13"
  }
}
